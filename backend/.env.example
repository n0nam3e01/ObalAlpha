# Local PostgreSQL. On Supabase use session-pooler on 5432 or direct connection.
DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5432/obal_local
DIRECT_URL=postgresql://postgres:PASSWORD@127.0.0.1:5432/obal_local
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
DEMO_MODE=false
# Never enable for real data: seed deletes orders and boxes.
ALLOW_DEMO_SEED=false
