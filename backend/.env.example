# Скопируйте в .env и подставьте свои значения. Реальные секреты сюда не пишем.

# Postgres (Supabase): pooler-строка для приложения
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Прямое подключение — используется миграциями Prisma
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Telegram: токен бота от @BotFather
TELEGRAM_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Подпись JWT — сгенерируйте: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-hex-string

PORT=3000

# Фича-флаги пилота
PAYMENTS_ENABLED=false
DEMO_MODE=true

# Разрешённый origin фронтенда
CORS_ORIGIN=http://localhost:5173
