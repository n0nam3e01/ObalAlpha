# Empty locally: Vite proxies /api to 127.0.0.1:3000.
# Prefer a same-origin /api proxy in production and leave this empty.
# Direct cross-site API URLs require backend SESSION_SAME_SITE=none + HTTPS;
# browsers blocking third-party cookies still require a same-site deployment.
# A direct API URL must omit /api; rebuild after changing it.
# Never put database passwords or JWT_SECRET in VITE_* variables.
VITE_API_URL=
VITE_DEV_ALLOWED_HOSTS=
